# OpenSCENARIO DSL (OSC2) example using serial ordering and a one_of choice.
#
# Transpiling this produces a scenario package with TWO concrete scenarios
# (one per one_of branch):
#
#     osc-transpile junction_choice.osc -o out/   # -> out/junction_choice_package/
#
# The package registers junction_choice_v0 (left turn) and junction_choice_v1
# (right turn), runnable via `uv run scenario scenario=junction_choice_v0/default`.
#
# Because the do block is serial, each step is gated on the previous one:
# the turn only fires after the lights are set green, and reaching the target
# lane is checked after the turn.

scenario junction_choice:
    ego: vehicle
    do serial:
        ego.drive() with:
            speed(20kmph)
            spawn_lanelet(242)
        set_traffic_lights(state: green)
        one_of:
            ego.turn(direction: left)
            ego.turn(direction: right)
        ego.reach_lane(lanelet: 460)
    timeout(12s)
